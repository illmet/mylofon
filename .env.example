# The process reads environment variables; it does not auto-load this file.
MYLOFON_BIND=127.0.0.1:3000
MYLOFON_ORIGIN=http://localhost:3000
MYLOFON_DATABASE=sqlite://data/mylofon.db
MYLOFON_KEY_FILE=data/account.key
# Enable only behind the supplied Caddy config on the same machine.
MYLOFON_TRUST_PROXY=false
RUST_LOG=mylofon=info,tower_http=warn
# Optional private metrics listener. Loopback only.
MYLOFON_METRICS_BIND=127.0.0.1:9101
